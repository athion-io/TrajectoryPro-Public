{
  "test_id": "prm-014",
  "name": "The change author signing for a quorum role is denied with SELF_APPROVAL even though every role has a signature",
  "category": "permission",
  "level": "MUST",
  "source": "C-PRM-4",
  "tags": [
    "approval",
    "self-approval"
  ],
  "requires": [
    "permission_probe"
  ],
  "steps": [
    {
      "kind": "request",
      "method": "POST",
      "path": "/permission/decide",
      "probe": true,
      "body": {
        "subject": {
          "kind": "user",
          "id": "u1",
          "roles": [
            "operations_lead"
          ],
          "work_center": "wc-a"
        },
        "verb": "approve_change",
        "resource": {
          "work_center": "wc-a",
          "workflow_instance": "wi-1",
          "change": {
            "author": "u3",
            "approvals": [
              {
                "by": "u3",
                "role": "process_engineer"
              },
              {
                "by": "u4",
                "role": "operations_lead"
              }
            ]
          }
        },
        "grants": [],
        "policy": {
          "quorum": [
            {
              "role": "process_engineer"
            },
            {
              "role": "operations_lead"
            }
          ],
          "separation_of_duties": "strict"
        }
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "path": "$.data.allowed",
            "equals": false
          },
          {
            "path": "$.data.reason",
            "equals": "SELF_APPROVAL"
          },
          {
            "path": "$.error",
            "absent": true
          }
        ]
      }
    }
  ]
}
