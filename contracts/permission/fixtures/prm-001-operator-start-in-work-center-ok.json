{
  "test_id": "prm-001",
  "name": "Operator starting a workflow in their own work center is allowed with reason OK",
  "category": "permission",
  "level": "MUST",
  "source": "C-PRM-1",
  "tags": [
    "role",
    "start"
  ],
  "requires": [
    "permission_probe"
  ],
  "steps": [
    {
      "kind": "request",
      "method": "POST",
      "path": "/permission/decide",
      "probe": true,
      "body": {
        "subject": {
          "kind": "user",
          "id": "u1",
          "roles": [
            "operator"
          ],
          "work_center": "wc-a"
        },
        "verb": "start",
        "resource": {
          "work_center": "wc-a",
          "workflow_instance": "wi-1"
        },
        "grants": []
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "path": "$.data.allowed",
            "equals": true
          },
          {
            "path": "$.data.reason",
            "equals": "OK"
          },
          {
            "path": "$.error",
            "absent": true
          }
        ]
      }
    }
  ]
}
