{
  "test_id": "prm-006",
  "name": "Grant matrix: scope own, subject does not own the instance, denied with GRANT_SCOPE_OWN",
  "category": "permission",
  "level": "MUST",
  "source": "C-PRM-2",
  "tags": [
    "work-center",
    "grant",
    "matrix"
  ],
  "requires": [
    "permission_probe"
  ],
  "steps": [
    {
      "kind": "request",
      "method": "POST",
      "path": "/permission/decide",
      "probe": true,
      "body": {
        "subject": {
          "kind": "user",
          "id": "u1",
          "roles": [
            "operator"
          ],
          "work_center": "wc-b"
        },
        "verb": "control:stop",
        "resource": {
          "work_center": "wc-a",
          "workflow_instance": "wi-1",
          "owner": "u2"
        },
        "grants": [
          {
            "from_work_center": "wc-b",
            "to_work_center": "wc-a",
            "scope": "own"
          }
        ]
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "path": "$.data.allowed",
            "equals": false
          },
          {
            "path": "$.data.reason",
            "equals": "GRANT_SCOPE_OWN"
          },
          {
            "path": "$.error",
            "absent": true
          }
        ]
      }
    }
  ]
}
