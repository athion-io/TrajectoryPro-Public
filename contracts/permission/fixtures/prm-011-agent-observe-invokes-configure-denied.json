{
  "test_id": "prm-011",
  "name": "An observe-mode agent invoking a configure-mode action is denied with AGENT_MODE_EXCEEDED",
  "category": "permission",
  "level": "MUST",
  "source": "C-PRM-3",
  "tags": [
    "agent",
    "mode"
  ],
  "requires": [
    "permission_probe"
  ],
  "steps": [
    {
      "kind": "request",
      "method": "POST",
      "path": "/permission/decide",
      "probe": true,
      "body": {
        "subject": {
          "kind": "agent",
          "id": "agent-1",
          "roles": [
            "agent"
          ],
          "work_center": "wc-a",
          "mode": "observe"
        },
        "verb": "invoke_action",
        "resource": {
          "work_center": "wc-a",
          "workflow_instance": "wi-1",
          "action_mode": "configure"
        },
        "grants": []
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "path": "$.data.allowed",
            "equals": false
          },
          {
            "path": "$.data.reason",
            "equals": "AGENT_MODE_EXCEEDED"
          },
          {
            "path": "$.error",
            "absent": true
          }
        ]
      }
    }
  ]
}
