{
  "test_id": "prm-004",
  "name": "An operator from another work center with no grant to the target work center is denied with WRONG_WORK_CENTER",
  "category": "permission",
  "level": "MUST",
  "source": "C-PRM-2",
  "tags": [
    "work-center",
    "grant"
  ],
  "requires": [
    "permission_probe"
  ],
  "steps": [
    {
      "kind": "request",
      "method": "POST",
      "path": "/permission/decide",
      "probe": true,
      "body": {
        "subject": {
          "kind": "user",
          "id": "u1",
          "roles": [
            "operator"
          ],
          "work_center": "wc-b"
        },
        "verb": "control:abort",
        "resource": {
          "work_center": "wc-a",
          "workflow_instance": "wi-1",
          "owner": "u1"
        },
        "grants": [
          {
            "from_work_center": "wc-b",
            "to_work_center": "wc-c",
            "scope": "any"
          }
        ]
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "path": "$.data.allowed",
            "equals": false
          },
          {
            "path": "$.data.reason",
            "equals": "WRONG_WORK_CENTER"
          },
          {
            "path": "$.error",
            "absent": true
          }
        ]
      }
    }
  ]
}
