{
  "test_id": "agt-070",
  "name": "An invalid forwarded user token answers 401 USER_UNAUTHORIZED with details.user",
  "category": "agent-action",
  "level": "EXTENSION:forwarded-identity",
  "tags": [
    "forwarded-identity",
    "auth",
    "invoke"
  ],
  "requires": [
    "forwarded-identity",
    "observable_action"
  ],
  "steps": [
    {
      "kind": "request",
      "method": "POST",
      "path": "/actions/{{roles.observable_action}}/invoke",
      "headers": {
        "X-Trajectory-User": "Bearer invalid-user-token-fixture"
      },
      "body": {
        "environment_oid": "{{roles.environment_oid}}",
        "workflow_instance_id": "wf-{{uniq}}",
        "step_instance_id": "step-{{uniq}}",
        "step_oid": "step-oid-{{uniq}}",
        "input_parameters": [
          {
            "name": "greeting",
            "value": "hello"
          }
        ]
      },
      "expect": {
        "status": 401,
        "json": [
          {
            "path": "$.error.code",
            "equals": "USER_UNAUTHORIZED"
          },
          {
            "path": "$.error.message",
            "type": "string"
          },
          {
            "path": "$.error.details.user",
            "present": true
          }
        ]
      }
    }
  ]
}