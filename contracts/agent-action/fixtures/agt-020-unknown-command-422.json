{
  "test_id": "agt-020",
  "name": "An unknown command name answers 422 INVALID_COMMAND",
  "category": "agent-action",
  "level": "MUST",
  "source": "REST-05",
  "tags": [
    "command",
    "envelope"
  ],
  "requires": [
    "observable_action",
    "commands"
  ],
  "setup": [
    {
      "kind": "request",
      "id": "invoke",
      "method": "POST",
      "path": "/actions/{{roles.observable_action}}/invoke",
      "body": {
        "environment_oid": "{{roles.environment_oid}}",
        "workflow_instance_id": "wf-{{uniq}}",
        "step_instance_id": "step-{{uniq}}",
        "step_oid": "step-oid-{{uniq}}",
        "input_parameters": [
          {
            "name": "greeting",
            "value": "hello"
          }
        ]
      },
      "capture": {
        "iid": "$.data.instance_id"
      },
      "expect": {
        "status": 201
      }
    },
    {
      "kind": "wait_state",
      "instance": "{{iid}}",
      "states": [
        "EXECUTING"
      ]
    }
  ],
  "steps": [
    {
      "kind": "request",
      "method": "POST",
      "path": "/instances/{{iid}}/command",
      "body": {
        "command": "JUMP"
      },
      "expect": {
        "status": 422,
        "json": [
          {
            "path": "$.error.code",
            "equals": "INVALID_COMMAND"
          },
          {
            "path": "$.error.message",
            "type": "string"
          }
        ]
      }
    }
  ],
  "teardown": [
    {
      "kind": "request",
      "method": "POST",
      "path": "/instances/{{iid}}/command",
      "body": {
        "command": "ABORT"
      },
      "tolerate": true
    }
  ]
}
