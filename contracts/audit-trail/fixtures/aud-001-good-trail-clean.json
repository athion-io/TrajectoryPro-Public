{
  "test_id": "aud-001",
  "name": "POST /audit/verify on a well-formed chained trail reports no issues",
  "category": "audit-trail",
  "level": "MUST",
  "source": "C-AUD-3",
  "tags": [
    "audit",
    "probe"
  ],
  "requires": [
    "audit_probe"
  ],
  "steps": [
    {
      "kind": "request",
      "method": "POST",
      "path": "/audit/verify",
      "probe": true,
      "trail": "audit-trail/fixtures/trails/good.jsonl",
      "expect": {
        "status": 200,
        "json": [
          {
            "path": "$.data.issues",
            "type": "array"
          },
          {
            "path": "$.data.issues",
            "equals": []
          }
        ]
      }
    }
  ]
}
