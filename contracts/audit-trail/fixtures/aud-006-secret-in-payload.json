{
  "test_id": "aud-006",
  "name": "POST /audit/verify reports secret_in_payload at the event whose payload holds a secret-looking key",
  "category": "audit-trail",
  "level": "MUST",
  "source": "C-AUD-6",
  "tags": [
    "audit",
    "probe"
  ],
  "requires": [
    "audit_probe"
  ],
  "steps": [
    {
      "kind": "request",
      "method": "POST",
      "path": "/audit/verify",
      "probe": true,
      "trail": "audit-trail/fixtures/trails/secret.jsonl",
      "expect": {
        "status": 200,
        "json": [
          {
            "path": "$.data.issues",
            "type": "array"
          },
          {
            "path": "$.data.issues[0].index",
            "equals": 3
          },
          {
            "path": "$.data.issues[0].issue",
            "equals": "secret_in_payload"
          },
          {
            "path": "$.data.issues[1]",
            "absent": true
          }
        ]
      }
    }
  ]
}
