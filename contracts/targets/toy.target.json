{
  "$schema": "../schema/target-schema.json",
  "name": "toy",
  "base_url": "http://toy.test/trajectory/v1",
  "auth": { "mode": "required", "header": "X-API-Key", "scheme": "" },
  "capabilities": ["observable_action", "opaque_action", "commands", "sse", "list", "delete", "cors"],
  "extensions": [],
  "roles": {
    "environment_oid": "env-c1",
    "observable_action": "act-hold",
    "opaque_action": "act-opaque",
    "fast_action": "act-fast",
    "offline_action": "act-offline",
    "unknown_action": "act-nope",
    "guarded_action": "act-guarded",
    "cors_origin": "http://runtime.test"
  },
  "timeouts": { "wait_s": 15, "sse_s": 15 },
  "known_failures": {}
}
