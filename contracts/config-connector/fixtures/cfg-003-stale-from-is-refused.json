{
  "test_id": "cfg-003",
  "name": "A change whose `from` is not the current value is refused 409 STALE_VALUE and nothing is written",
  "category": "config-connector",
  "level": "MUST",
  "source": "C-CFG-1",
  "tags": [
    "apply",
    "stale",
    "deltav-fhx"
  ],
  "requires": [
    "connector_probe"
  ],
  "steps": [
    {
      "kind": "request",
      "method": "POST",
      "path": "/connector/apply",
      "probe": true,
      "body": {
        "profile": "deltav-fhx",
        "mode": "test",
        "file_b64": "",
        "changes": [
          {
            "platform": "deltav-fhx",
            "item": "FAKE_PUMP_A/SETPOINT",
            "from": "11.0",
            "to": "12.5"
          }
        ]
      },
      "expect": {
        "status": 409,
        "json": [
          {
            "path": "$.error.code",
            "equals": "STALE_VALUE"
          },
          {
            "path": "$.error.details.item",
            "equals": "FAKE_PUMP_A/SETPOINT"
          },
          {
            "path": "$.error.details.expected",
            "equals": "11.0"
          },
          {
            "path": "$.error.details.actual",
            "equals": "10.0"
          },
          {
            "path": "$.data",
            "absent": true
          }
        ]
      }
    }
  ]
}
