{
  "test_id": "cfg-002",
  "name": "mimic-xml: patching one parameter yields the golden after file byte for byte",
  "category": "config-connector",
  "level": "MUST",
  "source": "C-CFG-4",
  "tags": [
    "apply",
    "mimic-xml"
  ],
  "requires": [
    "connector_probe"
  ],
  "steps": [
    {
      "kind": "request",
      "method": "POST",
      "path": "/connector/apply",
      "probe": true,
      "body": {
        "profile": "mimic-xml",
        "mode": "test",
        "file_b64": "",
        "changes": [
          {
            "platform": "mimic-xml",
            "item": "FAKE_TANK_A/LEVEL_SP",
            "from": "55",
            "to": "60"
          }
        ]
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "path": "$.data.before_hash",
            "equals": "sha256:0f2faaf5e19da758602ada45b803258ce29ffbb9ddfa7016135921341c847abf"
          },
          {
            "path": "$.data.after_b64",
            "equals": ""
          },
          {
            "path": "$.data.after_hash",
            "equals": "sha256:f81122efb235be9d239a2ffaed512ca1ee8ecb2d345efb37a3d586d8ce77d0b8"
          },
          {
            "path": "$.data.read_back.ok",
            "equals": true
          },
          {
            "path": "$.data.read_back.mismatches",
            "equals": []
          },
          {
            "path": "$.error",
            "absent": true
          }
        ]
      }
    }
  ]
}
