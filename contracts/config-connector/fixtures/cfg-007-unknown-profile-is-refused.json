{
  "test_id": "cfg-007",
  "name": "A profile nobody has is refused 400 VALIDATION_ERROR before anything is read",
  "category": "config-connector",
  "level": "MUST",
  "source": "C-CFG-5",
  "tags": [
    "apply",
    "profile"
  ],
  "requires": [
    "connector_probe"
  ],
  "steps": [
    {
      "kind": "request",
      "method": "POST",
      "path": "/connector/apply",
      "probe": true,
      "body": {
        "profile": "no-such-profile",
        "mode": "test",
        "file_b64": "",
        "changes": [
          {
            "platform": "no-such-profile",
            "item": "FAKE_PUMP_A/SETPOINT",
            "from": "10.0",
            "to": "12.5"
          }
        ]
      },
      "expect": {
        "status": 400,
        "json": [
          {
            "path": "$.error.code",
            "equals": "VALIDATION_ERROR"
          },
          {
            "path": "$.data",
            "absent": true
          }
        ]
      }
    }
  ]
}
