{
  "test_id": "cfg-004",
  "name": "A change naming an item the file does not contain is refused 400 ITEM_NOT_FOUND",
  "category": "config-connector",
  "level": "MUST",
  "source": "C-CFG-1",
  "tags": [
    "apply",
    "deltav-fhx"
  ],
  "requires": [
    "connector_probe"
  ],
  "steps": [
    {
      "kind": "request",
      "method": "POST",
      "path": "/connector/apply",
      "probe": true,
      "body": {
        "profile": "deltav-fhx",
        "mode": "test",
        "file_b64": "",
        "changes": [
          {
            "platform": "deltav-fhx",
            "item": "FAKE_PUMP_Z/SETPOINT",
            "from": "10.0",
            "to": "12.5"
          }
        ]
      },
      "expect": {
        "status": 400,
        "json": [
          {
            "path": "$.error.code",
            "equals": "ITEM_NOT_FOUND"
          },
          {
            "path": "$.error.details.item",
            "equals": "FAKE_PUMP_Z/SETPOINT"
          },
          {
            "path": "$.data",
            "absent": true
          }
        ]
      }
    }
  ]
}
